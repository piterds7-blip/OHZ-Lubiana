rules_version = '2';

// OHZ Lubiana — Żywienie
// Każda osoba ma własne konto (login + hasło, Firebase Authentication → Email/Password).
// Dostęp do danych ma TYLKO osoba, której profil jest w kolekcji `uzytkownicy`
// i nie jest zablokowana. Profile zakłada i zmienia wyłącznie Twórca (zakładka „Dostęp”).
//
// Wklej całość w konsoli Firebase: Firestore Database → Reguły → Opublikuj.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- kim jest pytający ----------
    function kontoZHaslem() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function sciezkaProfilu() {
      return /databases/$(database)/documents/uzytkownicy/$(request.auth.uid);
    }
    function aktywny() {
      return kontoZHaslem()
          && exists(sciezkaProfilu())
          && get(sciezkaProfilu()).data.aktywny == true;
    }
    function tworca() {
      return aktywny() && get(sciezkaProfilu()).data.tworca == true;
    }
    // „edycja” = osoba ma choć jedną zakładkę z prawem zmian (ustawia to Twórca)
    function edytor() {
      return aktywny()
          && (get(sciezkaProfilu()).data.tworca == true
              || get(sciezkaProfilu()).data.edycja == true);
    }

    // ---------- pierwsze uruchomienie: założenie konta Twórcy ----------
    // Działa tylko raz — dopóki nie istnieje dokument publiczne/start.
    function zakladaPierwszegoTworce() {
      return kontoZHaslem()
          && !exists(/databases/$(database)/documents/publiczne/start)
          && getAfter(/databases/$(database)/documents/publiczne/start).data.uid == request.auth.uid;
    }

    match /publiczne/start {
      allow get: if true;   // ekran logowania sprawdza, czy Twórca już jest
      allow create: if kontoZHaslem()
                    && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/uzytkownicy/$(request.auth.uid)).data.tworca == true;
      allow update, delete: if false;
    }

    // ---------- konta ----------
    match /uzytkownicy/{uid} {
      // własny profil można odczytać zawsze (aplikacja pokaże wtedy „konto zablokowane”)
      allow get:  if (kontoZHaslem() && uid == request.auth.uid) || tworca();
      allow list: if tworca();
      allow create: if tworca()
                    || (zakladaPierwszegoTworce() && uid == request.auth.uid
                        && request.resource.data.tworca == true
                        && request.resource.data.aktywny == true);
      allow update, delete: if tworca();
    }

    // login → konto. Pojedynczy odczyt jest publiczny (potrzebny do logowania),
    // listy loginów nie da się pobrać bez konta Twórcy.
    match /loginy/{login} {
      allow get:  if true;
      allow list: if tworca();
      allow create: if tworca() || zakladaPierwszegoTworce();
      allow update, delete: if tworca();
    }

    // ---------- konfiguracja ----------
    match /config/{dok} {
      allow read: if aktywny();
      // stary dokument z hasłami (sprzed kont) — nie wolno go już tworzyć ani zmieniać
      allow create, update: if edytor() && dok != 'passwords';
      allow delete: if tworca();
    }

    // ---------- dane ----------
    match /surowce/{id}     { allow read: if aktywny(); allow write: if edytor(); }
    match /dawki/{id}       { allow read: if aktywny(); allow write: if edytor(); }
    match /mieszanki/{id}   { allow read: if aktywny(); allow write: if edytor(); }
    match /produkcja/{id}   { allow read: if aktywny(); allow write: if edytor(); }
    match /snapshoty/{id}   { allow read: if aktywny(); allow write: if edytor(); }
    match /grupyTech/{id}   { allow read: if aktywny(); allow write: if edytor(); }
    match /zywienie/{id}    { allow read: if aktywny(); allow write: if edytor(); }
    match /zmianyDawek/{id} { allow read: if aktywny(); allow write: if edytor(); }
    match /wersjeDawek/{id} { allow read: if aktywny(); allow write: if edytor(); }
    match /paszowozy/{id}   { allow read: if aktywny(); allow write: if edytor(); }

    // Wszystko inne — zamknięte
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
